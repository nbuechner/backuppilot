{
  "productName": "BackupPilot",
  "version": "1.0.0",
  "identifier": "me.buechner.backuppilot",
  "build": {
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BackupPilot",
        "width": 900,
        "height": 660,
        "minWidth": 700,
        "minHeight": 500,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": {
      "../../target/release/backuppilot-daemon.exe": "./"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "installerHooks": "nsis/hooks.nsi"
      }
    }
  }
}
