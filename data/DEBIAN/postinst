#!/bin/sh
set -e

systemctl --user daemon-reload 2>/dev/null || true
systemctl --user enable backuppilot-daemon.service 2>/dev/null || true
systemctl --user start backuppilot-daemon.service 2>/dev/null || true

if ! command -v proxmox-backup-client >/dev/null 2>&1; then
    # Cannot call apt-get here — dpkg lock is held by the parent apt process.
    # Install via a one-shot systemd service that runs after this session exits.
    mkdir -p /usr/lib/backuppilot
    cat > /usr/lib/backuppilot/install-pbs-client.sh << 'SCRIPT'
#!/bin/sh
set -e
if command -v proxmox-backup-client >/dev/null 2>&1; then
    systemctl disable --now backuppilot-install-pbs-client.service 2>/dev/null || true
    exit 0
fi
echo "BackupPilot: Installing proxmox-backup-client from Proxmox repository..."
if command -v curl >/dev/null 2>&1; then
    curl -fsSL https://enterprise.proxmox.com/debian/proxmox-release-bookworm.gpg \
        -o /etc/apt/trusted.gpg.d/proxmox-release-bookworm.gpg
else
    wget -q -O /etc/apt/trusted.gpg.d/proxmox-release-bookworm.gpg \
        https://enterprise.proxmox.com/debian/proxmox-release-bookworm.gpg
fi
echo "deb http://download.proxmox.com/debian/pbs-client bookworm main" \
    > /etc/apt/sources.list.d/pbs-client.list
apt-get update -qq
apt-get install -y proxmox-backup-client
systemctl disable --now backuppilot-install-pbs-client.service 2>/dev/null || true
SCRIPT
    chmod 755 /usr/lib/backuppilot/install-pbs-client.sh

    cat > /etc/systemd/system/backuppilot-install-pbs-client.service << 'UNIT'
[Unit]
Description=Install proxmox-backup-client for BackupPilot
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/usr/bin/proxmox-backup-client

[Service]
Type=oneshot
ExecStart=/usr/lib/backuppilot/install-pbs-client.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
UNIT

    systemctl daemon-reload 2>/dev/null || true
    systemctl enable --now backuppilot-install-pbs-client.service 2>/dev/null || true
    echo "BackupPilot: proxmox-backup-client will be installed in the background."
fi
