#!/bin/sh
set -e

systemctl --user daemon-reload 2>/dev/null || true
systemctl --user enable backuppilot-daemon.service 2>/dev/null || true
systemctl --user start backuppilot-daemon.service 2>/dev/null || true

if ! command -v proxmox-backup-client >/dev/null 2>&1; then
    echo ""
    echo "========================================================="
    echo "  BackupPilot: proxmox-backup-client is not installed"
    echo "========================================================="
    echo ""
    echo "  BackupPilot requires proxmox-backup-client for backups"
    echo "  and restores. Install it with:"
    echo ""
    echo "    curl -fsSL https://enterprise.proxmox.com/debian/proxmox-release-bookworm.gpg \\"
    echo "      | sudo tee /etc/apt/trusted.gpg.d/proxmox-release-bookworm.gpg >/dev/null"
    echo "    echo 'deb http://download.proxmox.com/debian/pbs-client bookworm main' \\"
    echo "      | sudo tee /etc/apt/sources.list.d/pbs-client.list"
    echo "    sudo apt-get update && sudo apt-get install -y proxmox-backup-client"
    echo ""
    echo "========================================================="
    echo ""
fi
