#!/bin/sh
set -e

systemctl --user daemon-reload 2>/dev/null || true
systemctl --user enable backuppilot-daemon.service 2>/dev/null || true
systemctl --user start backuppilot-daemon.service 2>/dev/null || true

if ! command -v proxmox-backup-client >/dev/null 2>&1; then
    # Map distro to the appropriate Proxmox PBS client repo.
    # Tested matrix (as of 2025-06):
    #   Ubuntu 22.04 (jammy)    - NO working repo: too new for bullseye (no libssl1.1),
    #                             too old for bookworm (libzstd 1.4.8 < 1.5.2 required)
    #   Ubuntu 24.04 (noble)    - bookworm works
    #   Ubuntu 24.10+ (oracular, plucky, ...) - trixie works
    #   Ubuntu 26.04 (resolute) - trixie works (Proxmox updated packages for libfuse3-4)
    #   Debian bookworm         - bookworm works
    #   Debian trixie           - trixie works
    CODENAME=""
    ID=""
    VERSION_ID=""
    if [ -f /etc/os-release ]; then
        . /etc/os-release
        CODENAME="${VERSION_CODENAME:-}"
        ID="${ID:-}"
        VERSION_ID="${VERSION_ID:-}"
    fi

    PBS_REPO=""
    PBS_NO_COMPAT=""
    if [ "$ID" = "ubuntu" ] && [ -n "$VERSION_ID" ]; then
        # Compare as integers: 22.04 -> 2204, 24.04 -> 2404, 26.04 -> 2604
        VER_INT=$(echo "$VERSION_ID" | awk -F. '{printf "%d%02d", $1, $2}')
        if [ "$VER_INT" -le 2204 ]; then
            PBS_NO_COMPAT="yes"
        elif [ "$VER_INT" -le 2404 ]; then
            PBS_REPO="bookworm"
        else
            PBS_REPO="trixie"
        fi
    else
        case "$CODENAME" in
            bookworm) PBS_REPO="bookworm" ;;
            trixie)   PBS_REPO="trixie"   ;;
        esac
    fi

    echo ""
    echo "========================================================="
    echo "  BackupPilot: proxmox-backup-client is not installed"
    echo "========================================================="
    echo ""
    echo "  BackupPilot requires proxmox-backup-client for backups"
    echo "  and restores."
    echo ""

    if [ -n "$PBS_NO_COMPAT" ]; then
        echo "  Ubuntu $VERSION_ID is not compatible with any current Proxmox package repo:"
        echo "  bullseye packages require libssl1.1 (removed in 22.04),"
        echo "  bookworm packages require libzstd >= 1.5.2 (22.04 ships 1.4.8)."
        echo ""
        echo "  Please upgrade to Ubuntu 24.04 LTS and re-install BackupPilot."
    else
        case "$PBS_REPO" in
            bookworm)
                echo "  Install it with:"
                echo ""
                echo "    sudo mkdir -p /etc/apt/keyrings"
                echo "    curl -fsSL https://enterprise.proxmox.com/debian/proxmox-release-bookworm.gpg \\"
                echo "      | sudo tee /etc/apt/keyrings/proxmox-release-bookworm.gpg >/dev/null"
                echo "    echo 'deb [signed-by=/etc/apt/keyrings/proxmox-release-bookworm.gpg]" \
                     "http://download.proxmox.com/debian/pbs-client bookworm main' \\"
                echo "      | sudo tee /etc/apt/sources.list.d/pbs-client.list"
                echo "    sudo apt-get update && sudo apt-get install -y proxmox-backup-client"
                ;;
            trixie)
                echo "  Install it with:"
                echo ""
                echo "    sudo mkdir -p /etc/apt/keyrings"
                echo "    curl -fsSL https://enterprise.proxmox.com/debian/proxmox-release-trixie.gpg \\"
                echo "      | sudo tee /etc/apt/keyrings/proxmox-release-trixie.gpg >/dev/null"
                echo "    echo 'deb [signed-by=/etc/apt/keyrings/proxmox-release-trixie.gpg]" \
                     "http://download.proxmox.com/debian/pbs-client trixie main' \\"
                echo "      | sudo tee /etc/apt/sources.list.d/pbs-client.list"
                echo "    sudo apt-get update && sudo apt-get install -y proxmox-backup-client"
                ;;
            *)
                echo "  Your system (${CODENAME:-unknown}) may not have official Proxmox packages."
                echo "  Please check the Proxmox download page for your distribution:"
                echo ""
                echo "    https://www.proxmox.com/en/downloads/proxmox-backup-client"
                ;;
        esac
    fi

    echo ""
    echo "========================================================="
    echo ""
fi
