#!/bin/sh
set -e

systemctl --user daemon-reload 2>/dev/null || true
systemctl --user enable backuppilot-daemon.service 2>/dev/null || true
systemctl --user start backuppilot-daemon.service 2>/dev/null || true

if ! command -v proxmox-backup-client >/dev/null 2>&1; then
    # Detect distro codename
    CODENAME=""
    if [ -f /etc/os-release ]; then
        . /etc/os-release
        CODENAME="${VERSION_CODENAME:-}"
    fi

    echo ""
    echo "========================================================="
    echo "  BackupPilot: proxmox-backup-client is not installed"
    echo "========================================================="
    echo ""
    echo "  BackupPilot requires proxmox-backup-client for backups"
    echo "  and restores."
    echo ""

    case "$CODENAME" in
        bookworm|noble)
            # Debian 12 / Ubuntu 24.04 -- use Proxmox 8 (bookworm) packages
            echo "  Install it with:"
            echo ""
            echo "    curl -fsSL https://enterprise.proxmox.com/debian/proxmox-release-bookworm.gpg \\"
            echo "      | sudo tee /etc/apt/trusted.gpg.d/proxmox-release-bookworm.gpg >/dev/null"
            echo "    echo 'deb http://download.proxmox.com/debian/pbs-client bookworm main' \\"
            echo "      | sudo tee /etc/apt/sources.list.d/pbs-client.list"
            echo "    sudo apt-get update && sudo apt-get install -y proxmox-backup-client"
            ;;
        trixie|resolute)
            # Debian 13 / Ubuntu 26.04 -- use Proxmox 9 (trixie) packages
            echo "  Install it with:"
            echo ""
            echo "    curl -fsSL https://enterprise.proxmox.com/debian/proxmox-release-trixie.gpg \\"
            echo "      | sudo tee /etc/apt/trusted.gpg.d/proxmox-release-trixie.gpg >/dev/null"
            echo "    echo 'deb http://download.proxmox.com/debian/pbs-client trixie main' \\"
            echo "      | sudo tee /etc/apt/sources.list.d/pbs-client.list"
            echo "    sudo apt-get update && sudo apt-get install -y proxmox-backup-client"
            ;;
        *)
            echo "  Your system ($CODENAME) may not have official Proxmox packages."
            echo "  Please check the Proxmox download page for your distribution:"
            echo ""
            echo "    https://www.proxmox.com/en/downloads/proxmox-backup-client"
            ;;
    esac

    echo ""
    echo "========================================================="
    echo ""
fi
